# Settings... in the Menu of the controls at the left changes the common settings and its "Open settings file" makes a taslation.toml
# from this file where there is none (each setting a note there, until its "#" is deleted). By hand: copy this file
# to taslation.toml. TASlation reads the first of: the file given with --config; ./taslation.toml in the
# directory you run taslation from (or next to this file, in a checkout); taslation.toml in the state folder
# (~/.taslation, or TASLATION_STATE_DIR: the place for an installed program); else these defaults.
# `taslation doctor` prints which file it read.
# Every key is optional; these are the defaults. Keys are the fields of taslation/config.py:Settings. A key this
# version does not know is left out, and the window names it once.

# --- translation: a local Ollama server only (the URL must be a loopback address) ---
ollama_url = "http://127.0.0.1:11434"
ollama_model = "auto"         # "auto": PLaMo 3 Translate 2B for every language it writes, Qwen3.5 4B for Brazilian Portuguese and Turkish; or an Ollama model of your own (see docs/MANUAL.md, the section on choosing the model)
ollama_timeout = 900.0
ollama_temperature = 0.2
ollama_num_ctx = 16384        # the chat translator's context window (0 = server default); PLaMo has its own (8192)
ollama_keep_alive = "5m"      # how long Ollama keeps the model in GPU memory after a request: "5m", "2h", or seconds ("0": unload after each request); TASlation's start (load_model_at_start) or the first line to translate loads it, Menu > Release the model now or quitting TASlation releases it. "-1": load it at the start and never unload
load_model_at_start = true    # TASlation loads the translation model at its start, beside the OCR model, so the first page does not wait for it (it goes after ollama_keep_alive as ever; also Settings... > System). false: the first line to translate loads it
ollama_num_gpu = ""           # how many of the model's layers Ollama puts on the GPU: "" lets Ollama decide (the fastest); "0": the processor only, the GPU left free for something else (several times slower); a number: that many layers on the GPU (also Settings... > System). Menu > Release the model now gives the GPU memory back at once
ollama_window_cache = "auto"  # the Ollama TASlation starts keeps the cache of the model's whole window, and 256 MB of earlier requests in RAM: translation about a quarter faster, for about 130 MB more GPU memory (220 MB above 6 GB). "auto" (the default) and "on": with it; "off": as before (also Settings... > System; from Ollama's next start)
target_language = "English"
context_pages = 2             # live mode: previous pages given to the model as context (memory only; PLaMo's earlier
                              # lines grow to 60 and are cut back to the newest 20; 0: none)

# --- the pages turned past, translated behind the reader ---
context_pairs = 40            # previous (source, translation) pairs carried into the next request (PLaMo: as above)

# --- OCR ---
# models_dir = "C:/path/to/models"   # where setup_models.py put the OCR model (default: ./models)
ocr_threads = 0               # threads for the OCR model (0 = one per core); while other programs keep the CPU busy, half the cores can be faster
ocr_runs_on = "auto"          # "auto": two of the OCR readers where the check at the start puts them (the GPU when everything fits); "cpu"; "gpu"
gpu_short = "ask"             # when the GPU's memory is short at the start: "ask" (a dialog), or "processor" (what does not fit runs on the processor, without asking)

# --- detection ---
white_threshold = 225
dark_threshold = 140
min_bubble_area_ratio = 0.0006
max_bubble_area_ratio = 0.20
min_bubble_size = 24
min_short_bubble = 60         # a smaller region read as 1-2 characters is treated as noise, unless it is a bubble's short line the OCR is sure of (0.95+, led by a hiragana or a kanji)
ocr_min_confidence = 0.65     # OCR readings with a lower confidence (the characters' mean heat times their mean classifier probability) are dropped (on lettering about 0.9)
detect_text_blocks = true     # also find dialogue lettered straight onto light areas (no bubble)
detect_dark_bubbles = true    # also find dark bubbles and light lettering on dark areas
split_joined_bubbles = true   # bubbles that touch or overlap (one white area): one region per bubble, cut at the neck or the junction
take_columns_beyond = false   # dark bubbles: also read a column that goes on past the interior on the bubble's own black
slant_text = true             # lettering set at a slant: measured, read turned upright and lettered at its slant (false: all upright)
translate_sfx = true          # translate short katakana sound effects found outside bubbles
detect_model = "auto"         # the layout model first, the classical detectors add what it missed: "auto" (where art_erase runs too: with its "auto", only on a computer with a GPU and both page models installed; elsewhere classical alone), "on" or "off" (classical alone, the default of earlier versions)
margins = [0, 0, 0, 0]        # left, top, right, bottom pixels of the capture to ignore ("Set area" in the GUI)

# --- rendering ---
font_path = ""                # empty = the series sheet's font where installed, then models/fonts (setup_models.py --font), then Windows fonts
min_font_size = 9
max_font_size = 64
text_scale = 1.0              # the lettering's size (0.5-2.0; the dialogs offer 80-200 %): 0.9 sets every translation a tenth smaller, 1.2 larger where the page's sizes held it back (never over its bubble or max_font_size); a book can have its own (Book settings... in translator mode)
line_spacing = 1.12
readable_font_size = 11      # a translation set smaller than this is flagged "small" for review (0 = never)
spellcheck = false           # flag a word the dictionary does not know; its word lists (the pyspellchecker package) are an optional extra that TASlation does not install
enforce_terms = true         # a translation that misses a rendering from the series sheet is flagged "rendering" for review
uppercase = false
size_emphasis = true          # the part of a bubble the original letters larger is set larger in the translation too, where it is found there (one or two requests beside the page's for such a bubble; the words never change) and the bubble holds both sizes; false: every translation at one size
erase_mode = "fill"           # "fill": the bubble's own paper, flat or along its shading, within its outline; "inpaint": the lettering inpainted (keeps toned bubble interiors); "classic": the erase of before 2026-10-30 (one flat colour, lettering told by light and dark alone)
art_erase = "auto"            # with "fill", lettering on the drawing is inpainted by LaMa, once its model is installed: "auto" only where PyTorch has a CUDA GPU (elsewhere the erase is as with "off"), "lama" always, on the CPU too (about 4 s a screen), or "off"

# --- translation cache (translated text + bubble geometry + page fingerprints; never images) ---
# state_dir = "~/.taslation"
cache_enabled = true
fingerprint_max_distance = 36
match_min_iou = 0.4
reuse_lines = true            # a short line translated before in the book or its series gets that translation again, without a request (a correction of yours first); kept in the book's cache under a keyed hash of the line, never the Japanese

# --- following the viewer (you turn the pages in the viewer; TASlation presses no key) ---
# A viewer that stays black (a stuck loading screen, say) may just be loading: after about 8 s the status line says so,
# after black_wait_s it tells you to reload the book in its own window (click the book, then its reload key: F5 in a
# browser). TASlation presses no key for it, and goes on by itself once the page shows.
black_wait_s = 30             # seconds a black viewer is waited for before you are told to reload it
page_turn_wait_ms = 3000      # how long a viewer that draws nothing after a turn is waited for before it is looked at again
settle_ms = 400
early_start = true            # a new page is read from its first frame; it asks the model and is kept once that frame stays (false: wait settle_ms first)

# --- app ---
role = "reader"               # Edit at the start: "reader" (off) | "translator" (on: mark text, fix translations); a book's own choice comes first
ui_language = ""              # language of the controls and dialogs: en, ja, es, pt, fr, de, it, nl, pl, ru, tr, id, vi, zh, zh-tw, ko, th (empty = first-start choice)
ui_scale = 1.0                # size of the dialogs' text, times what Windows sets for the monitor (0.5-3.0; also Settings...)
theme = "system"              # the dialogs' and menus' colours: "system" (as Windows' app mode), "light" or "dark"; Windows' high contrast comes first (also Settings...)
auto_interval_ms = 700
see_through_indicators = true # the pane at the right edge of the viewer's area - the bubble last under the pointer (its original, its translation, Copy and Ask again) and the indicators; off, neither shows (the switch in the controls at the left, or Settings..., keeps the choice here)
hover_delay_ms = 450          # how long the pointer rests on a bubble's lettering before it gives way to the original under it (0-3000; 0: at once)
follow = "events"             # "events": the viewer is captured every auto_interval_ms only while the viewer itself is in front, never while neither is; "poll": every auto_interval_ms
update_check = "off"          # "daily": when TASlation starts, look for a new version at most once a day (check_update.py asks GitHub for one small file; nothing about you or your books is sent); "off": only Help > Check for updates... in the Menu asks, when you choose it; also Settings...
debug = false
